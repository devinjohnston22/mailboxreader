# Copy to .env.website. Public configuration only; no credentials here.
# Use a hostname you control, with its A/AAAA records pointing to your server.
DASHBOARD_DOMAIN=finance.your-domain.com
ACME_EMAIL=you@your-domain.com
# Explicitly set 8443 to run this dashboard independently of an existing port 443 service.
DASHBOARD_HTTPS_PORT=443
