{
  "name": "Mailbox Reader \u2014 Outlook live (read only)",
  "active": false,
  "nodes": [
    {
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "claim-page",
      "name": "Claim page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/sync/live/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_API_HEADER_CREDENTIAL",
          "name": "Mailbox Reader API"
        }
      }
    },
    {
      "id": "page-ready",
      "name": "Page ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ready",
              "leftValue": "={{ $json.ready }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "read-outlook-page",
      "name": "Read Outlook page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "IdType=\"ImmutableId\", outlook.body-content-type=\"text\""
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 90000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "credentials": {
        "oAuth2Api": {
          "id": "CONFIGURE_OUTLOOK_READ_ONLY_OAUTH",
          "name": "Outlook Mail.Read only"
        }
      }
    },
    {
      "id": "commit-page",
      "name": "Commit page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/sync/live/page",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { lease: $(\"Claim page\").first().json.lease, status: $json.statusCode, body: $json.body, headers: $json.headers } }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_API_HEADER_CREDENTIAL",
          "name": "Mailbox Reader API"
        }
      }
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Claim page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim page": {
      "main": [
        [
          {
            "node": "Page ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Page ready": {
      "main": [
        [
          {
            "node": "Read Outlook page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Outlook page": {
      "main": [
        [
          {
            "node": "Commit page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "executionTimeout": 300
  },
  "pinData": {},
  "tags": []
}
